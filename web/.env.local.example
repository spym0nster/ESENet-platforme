# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute site URL, used for canonical/OG URLs, the sitemap, and links in
# outgoing emails. Falls back to the Vercel production URL if unset.
NEXT_PUBLIC_SITE_URL=https://esenet-platforme.vercel.app

# ── Transactional email (Resend) ───────────────────────────────────────
# Auth emails (password reset, signup confirmation, magic link) are sent
# via the Supabase "Send Email Hook" → /api/auth/email-hook.

# Resend API key (resend.com → API Keys).
RESEND_API_KEY=

# From address. Defaults to Resend's shared onboarding@resend.dev, which
# only delivers to the Resend account owner until you verify a domain.
# EMAIL_FROM=ESENet <no-reply@your-domain>

# Signing secret for the Send Email Hook. Generate it in the Supabase
# dashboard: Authentication → Hooks → Send Email Hook (format "v1,whsec_…").
# Point that hook at https://<your-domain>/api/auth/email-hook.
SEND_EMAIL_HOOK_SECRET=

# Service-role key (Project Settings → API → service_role). Server-only,
# bypasses RLS. Only used to resolve a recipient's email address when
# mirroring in-app notifications to email. Leave unset to keep
# notifications in-app only.
SUPABASE_SERVICE_ROLE_KEY=
